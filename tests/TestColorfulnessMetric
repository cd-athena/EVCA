import unittest
import numpy as np
import sys
import os

sys.path.append(os.path.abspath(os.path.join(os.path.dirname(__file__), '..')))
from libs.colorfulness import (
    calculate_hasler_suesstrunk_colorfulness,
    calculate_hasler_suesstrunk_colorfulness_yuv
)

class TestColorfulnessMetric(unittest.TestCase):

    def setUp(self):
        # 1080p resolution mock dimensions
        self.h, self.w = 1080, 1920

    def test_rgb_grayscale_is_zero(self):
        """A purely grayscale image should have 0.0 colorfulness."""
        # Create a uniform gray frame (R=G=B=128)
        gray_frame = np.full((self.h, self.w, 3), 128, dtype=np.uint8)
        colorfulness = calculate_hasler_suesstrunk_colorfulness(gray_frame)
        self.assertAlmostEqual(colorfulness, 0.0, places=5)

    def test_rgb_pure_red_is_high(self):
        """A pure red image should yield a high colorfulness score."""
        red_frame = np.zeros((self.h, self.w, 3), dtype=np.uint8)
        red_frame[:, :, 0] = 255 # Pure Red
        colorfulness = calculate_hasler_suesstrunk_colorfulness(red_frame)
        self.assertGreater(colorfulness, 80.0)

    def test_yuv_grayscale_is_zero(self):
        """A purely grayscale YUV image (U=V=128 in 8-bit) should have 0.0 colorfulness."""
        # For 8-bit, 128 is the neutral chroma point
        u_plane = np.full((self.h // 2, self.w // 2), 128, dtype=np.uint8)
        v_plane = np.full((self.h // 2, self.w // 2), 128, dtype=np.uint8)
        
        colorfulness = calculate_hasler_suesstrunk_colorfulness_yuv(u_plane, v_plane, bit_depth=8)
        self.assertAlmostEqual(colorfulness, 0.0, places=5)

    def test_rgb_vs_yuv_correlation(self):
        """Ensure both methods reflect relative changes consistently."""
        # Frame 1: Low colorfulness (mostly gray with slight tint)
        rgb_low = np.random.randint(120, 135, (self.h, self.w, 3), dtype=np.uint8)
        u_low = np.random.randint(120, 135, (self.h // 2, self.w // 2), dtype=np.uint8)
        v_low = np.random.randint(120, 135, (self.h // 2, self.w // 2), dtype=np.uint8)

        # Frame 2: High colorfulness (high variance across channels)
        rgb_high = np.random.randint(0, 255, (self.h, self.w, 3), dtype=np.uint8)
        u_high = np.random.randint(0, 255, (self.h // 2, self.w // 2), dtype=np.uint8)
        v_high = np.random.randint(0, 255, (self.h // 2, self.w // 2), dtype=np.uint8)

        # Calculate metrics
        c_rgb_low = calculate_hasler_suesstrunk_colorfulness(rgb_low)
        c_rgb_high = calculate_hasler_suesstrunk_colorfulness(rgb_high)
        
        c_yuv_low = calculate_hasler_suesstrunk_colorfulness_yuv(u_low, v_low, bit_depth=8)
        c_yuv_high = calculate_hasler_suesstrunk_colorfulness_yuv(u_high, v_high, bit_depth=8)

        # High should strictly be greater than Low in both spaces
        self.assertGreater(c_rgb_high, c_rgb_low)
        print(c_rgb_high)
        print(c_rgb_low)
        self.assertGreater(c_yuv_high, c_yuv_low)
        print(c_yuv_high)
        print(c_yuv_low)
    
    def test_rgb_real_picture_mock(self):
        """Test the metric on a synthetic 'real' picture with varied colors."""
        # Create a synthetic image with a color gradient (e.g., simulating a sunset)
        gradient = np.zeros((self.h, self.w, 3), dtype=np.uint8)
        
        # Create spatial gradients to simulate color variance
        x = np.linspace(0, 255, self.w, dtype=np.uint8)
        y = np.linspace(0, 255, self.h, dtype=np.uint8)
        xv, yv = np.meshgrid(x, y)
        
        # Assign to channels: Red gradient horizontally, Blue gradient vertically, Green constant
        gradient[:, :, 0] = xv  # Red varies horizontally
        gradient[:, :, 1] = 128 # Green is constant
        gradient[:, :, 2] = yv  # Blue varies vertically
        
        colorfulness = calculate_hasler_suesstrunk_colorfulness(gradient)
        
        # A picture with a full spectrum of red and blue should have a substantial colorfulness score
        self.assertGreater(colorfulness, 100.0)
        self.assertIsInstance(colorfulness, float)

if __name__ == '__main__':
    unittest.main()